---
import Base from '../layouts/Base.astro';
import ModeSwitch from '../components/ModeSwitch.astro';
import ReturnAnswer from '../components/ReturnAnswer.astro';
import TradeoffCard from '../components/TradeoffCard.astro';
import Knobs from '../components/Knobs.astro';
import MiniBar from '../components/MiniBar.astro';
import { SIMPLE } from '../lib/fire.js';

// 簡單版:5 個數字 + 報酬率滑桿
const knobs = [
  { id: 'age', label: '目前年齡', unit: '歲', min: 20, max: 65, step: 1 },
  { id: 'fireAge', label: '想幾歲退休', unit: '歲', min: 30, max: 75, step: 1 },
  { id: 'monthlyExpense', label: '退休後每月生活費', unit: '萬', min: 2, max: 20, step: 0.5 },
  { id: 'assets', label: '目前存款與投資', unit: '萬', min: 0, max: 5000, step: 10 },
  { id: 'monthlySaving', label: '每月能存下', unit: '萬', min: 0, max: 30, step: 0.5 },
];
---
<Base title="SealHack" description="輸入年齡、想幾歲退休、生活費與存款,拉動報酬率,看退休要準備多少錢、存不存得到、最早幾年幾個月後能退休。">
  <ModeSwitch />
  <ReturnAnswer />

  <section class="mx-auto max-w-6xl px-4 mt-8">
    <form id="fire-form" autocomplete="off" onsubmit="return false">
      <Knobs knobs={knobs} />
    </form>
    <p class="mt-3 text-sm muted">
      簡單版假設:通膨 {Math.round(SIMPLE.inflation * 100)}%、每月存款隨通膨增加、退休後每年提領生活費到 95 歲;不計房貸、勞保勞退與大額支出。
      <a href="/full/" class="link">要算這些、或設定每年加薪,請用完整版</a>
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 mt-6 space-y-4 sm:space-y-6">
    <TradeoffCard />
    <a href="/full/" class="card next">
      <div>
        <p class="font-bold">有房貸、勞保勞退、加薪或大額支出?</p>
        <p class="text-sm muted mt-1">完整版用月收入與每年加薪算存款,並把貸款、年金與大額支出都算進去。</p>
      </div>
      <span class="next-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <MiniBar />

  <script>
    import { mount } from '../scripts/simple-app.js';
    mount();
  </script>
</Base>
