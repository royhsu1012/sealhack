---
import Base from '../layouts/Base.astro';

// 基本參數欄位:id 對應 Inputs 的 key;pct = 介面以 % 輸入、引擎以小數計算
const basic = [
  { group: '生活與 FIRE 目標', fields: [
    { id: 'fireYear', label: '預計開始 FIRE 的年份', unit: '年', step: 1 },
    { id: 'age', label: '目前年齡', unit: '歲', step: 1 },
    { id: 'monthlyExpense', label: '今日每月生活費', unit: '萬/月', step: 0.5, hint: '以今年物價計,不含貸款' },
    { id: 'inflation', label: '每年通膨率', unit: '%', step: 0.1, pct: true },
    { id: 'swr', label: '安全提領率', unit: '%', step: 0.1, pct: true, hint: 'FIRE 後每年提領資產的比例' },
  ]},
  { group: '正職收入與資產', fields: [
    { id: 'salary', label: '稅後年收入(含年終)', unit: '萬/年', step: 5 },
    { id: 'salaryGrowth', label: '薪資年成長率', unit: '%', step: 0.5, pct: true },
    { id: 'salaryCap', label: '稅後年收入上限', unit: '萬/年', step: 10, hint: '留空 = 不設上限' },
    { id: 'assets', label: '目前可投資資產', unit: '萬', step: 10 },
    { id: 'emergencyMonths', label: '緊急預備金', unit: '個月', step: 1, hint: '從資產扣除、不投入市場' },
    { id: 'assumedReturn', label: '你預期的年化報酬率', unit: '%', step: 0.5, pct: true, hint: '用來算最早可 FIRE 的年份' },
  ]},
];
---
<Base title="SealHack">
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-6">
    <span class="card-eyebrow">FIRE 財務規劃試算</span>
    <h1 class="mt-2 text-3xl sm:text-5xl font-extrabold">什麼時候可以財務自由？</h1>
    <p class="mt-3 max-w-2xl" style="color:var(--fg-muted)">
      輸入生活費、薪資、貸款與年金,算出 FIRE 需要累積多少資金,以及投資報酬率至少要多少。
      所有計算都在你的瀏覽器內完成,資料只存在這台裝置。
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 grid gap-6 lg:grid-cols-[minmax(0,380px)_minmax(0,1fr)] items-start">
    <!-- 輸入 -->
    <form id="fire-form" class="space-y-5" autocomplete="off" onsubmit="return false">
      {basic.map((g) => (
        <fieldset class="panel p-4">
          <legend class="sr-only">{g.group}</legend>
          <div class="text-sm font-bold mb-3">{g.group}</div>
          <div class="grid grid-cols-2 gap-3">
            {g.fields.map((f) => (
              <div class="field">
                <label for={f.id}>{f.label}</label>
                <div class="inp-unit">
                  <input id={f.id} name={f.id} class="inp" type="number" inputmode="decimal" step={f.step}
                    data-key={f.id} data-pct={f.pct ? '1' : undefined} />
                  <span>{f.unit}</span>
                </div>
                {f.hint && <div class="hint">{f.hint}</div>}
              </div>
            ))}
          </div>
        </fieldset>
      ))}

      <fieldset class="panel p-4">
        <legend class="sr-only">貸款明細</legend>
        <div class="flex items-center justify-between mb-1">
          <div class="text-sm font-bold">貸款明細</div>
          <button type="button" class="btn-ghost" data-add="loans">＋ 新增貸款</button>
        </div>
        <p class="hint mb-3" style="font-size:.72rem;color:var(--fg-muted)">房貸、車貸、信貸等;月付金與 FIRE 時餘額自動計算</p>
        <div id="list-loans" class="space-y-3"></div>
      </fieldset>

      <fieldset class="panel p-4">
        <legend class="sr-only">年金與被動收入</legend>
        <div class="flex items-center justify-between mb-1">
          <div class="text-sm font-bold">年金與被動收入</div>
          <button type="button" class="btn-ghost" data-add="incomes">＋ 新增</button>
        </div>
        <p class="hint mb-3" style="font-size:.72rem;color:var(--fg-muted)">勞保、勞退請填官方試算的月領金額(今日幣值);開始年齡留空 = FIRE 時開始</p>
        <div id="list-incomes" class="space-y-3"></div>
      </fieldset>

      <fieldset class="panel p-4">
        <legend class="sr-only">一次性財務目標</legend>
        <div class="flex items-center justify-between mb-1">
          <div class="text-sm font-bold">一次性財務目標</div>
          <button type="button" class="btn-ghost" data-add="goals">＋ 新增目標</button>
        </div>
        <p class="hint mb-3" style="font-size:.72rem;color:var(--fg-muted)">換車、子女教育等大額支出;以今日幣值輸入,自動依通膨調整</p>
        <div id="list-goals" class="space-y-3"></div>
      </fieldset>

      <div class="flex gap-2">
        <button type="button" id="reset" class="btn-ghost">恢復範例值</button>
      </div>
    </form>

    <!-- 結果 -->
    <div class="space-y-6 min-w-0" aria-live="polite">
      <div class="panel p-5">
        <p id="lead" class="text-base sm:text-lg font-semibold leading-relaxed"></p>
        <div id="stats" class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-4"></div>
      </div>

      <div class="panel p-5">
        <h2 class="text-lg font-bold">目標資金拆解</h2>
        <div id="breakdown" class="mt-3 sh-table"></div>
      </div>

      <div class="panel p-5">
        <h2 class="text-lg font-bold">逐年可投入金額</h2>
        <p class="text-sm mt-1" style="color:var(--fg-muted)">稅後收入 − 生活費 − 貸款 − 財務目標;紅色年份要從投資部位提領。</p>
        <div id="chart-cashflow" class="chart mt-3"></div>
      </div>

      <div class="panel p-5">
        <h2 class="text-lg font-bold">資產累積路徑</h2>
        <p id="traj-note" class="text-sm mt-1" style="color:var(--fg-muted)"></p>
        <div id="chart-assets" class="chart mt-3"></div>
      </div>

      <div class="panel p-5">
        <h2 class="text-lg font-bold">負債與現金流檢核</h2>
        <div id="checks" class="mt-3 sh-table"></div>
      </div>

      <div class="panel p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-lg font-bold">敏感度分析</h2>
          <label class="text-sm flex items-center gap-2" style="color:var(--fg-muted)">變動
            <select id="sens-key" class="inp" style="width:auto">
              <option value="fireYear">FIRE 年份</option>
              <option value="salary">稅後年收入</option>
              <option value="monthlyExpense">每月生活費</option>
              <option value="salaryGrowth">薪資成長率</option>
              <option value="salaryCap">收入上限</option>
              <option value="inflation">通膨率</option>
              <option value="swr">安全提領率</option>
            </select>
          </label>
        </div>
        <p class="text-sm mt-1" style="color:var(--fg-muted)">其餘參數固定為左側輸入值,每次只變動一項。「≤ 0%」代表不靠投資收益也能達標。</p>
        <div id="sens" class="mt-3 sh-table"></div>
      </div>
    </div>
  </section>

  <script>
    import { mount } from '../scripts/fire-app.js';
    mount();
  </script>
</Base>
