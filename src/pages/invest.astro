            <h4>具體方法</h4>
            <ul>{b.methods.map((s) => <li>{s}</li>)}</ul>
            {b.id === 'maggiulli' && <a class="inv-link" href="/invest/keep-buying/"><span>17 個觀點與更多數據</span><b>看持續買進分頁</b></a>}
            <p class="book-links">對應數據:{b.evidence.map((id) => <a href={`#${id}`}>{({ hold: '持有越久', growth: '報酬來源', timing: '一次投入與抄底', 'best-days': '錯過最好的幾天', mood: '市場先生', cape: '買進價格', drawdown: '大跌之後', fees: '成本' })[id]}</a>)}</p>
          </div>
        </details>
      ))}
    </div>

    <section class="inv-src">
      <h2 class="inv-h2">資料來源與限制</h2>
      <ul>
        <li>{E.sources.tw}。</li>
        <li>{E.sources.us};股息以每月殖利率 ÷ 12 估算,{E.sources.cape}。</li>
        <li>研究與文件:<a href="https://www.berkshirehathaway.com/letters/letters.html">波克夏股東信</a>(2017、2018 年)、<a href="https://ofdollarsanddata.com/even-god-couldnt-beat-dollar-cost-averaging/">Of Dollars and Data</a>(馬朱利的抄底實驗)、<a href="https://www.spglobal.com/spdji/en/spiva/article/spiva-us-year-end-2025/">SPIVA U.S. Year-End 2025</a>、Bessembinder(2018)〈Do Stocks Outperform Treasury Bills?〉。</li>
        <li>所有報酬率都是名目、含息、未扣費用與稅;美股是一個「事後看來很成功」的市場,台股資料只有 24 年,都不代表未來。數據更新於 {E.generated},重算方式見 <code>scripts/evidence.mjs</code>。</li>
        <li>本頁整理書中的原則與歷史數據,不推薦任何特定標的,不構成投資建議。</li>
      </ul>
    </section>
  </div>

  <script type="application/json" id="hit-data" set:html={JSON.stringify(E.hit)} />
  <script>
    import { loadState, pct, pctUp } from '../scripts/shared.js';
    import { breakEvenReturn, historyHitRate } from '../lib/fire.js';

    const hit = JSON.parse(document.getElementById('hit-data')?.textContent || '{}');
    const s = loadState();
    const inp = s.inputs;
    const be = breakEvenReturn(inp);
    const r = Math.max(0, inp.assumedReturn);
    const rate = { be: be ?? null, r };
    const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set('need-be', be == null ? '50% 也不夠' : be === 0 ? '0% 就夠' : pctUp(be));
    set('need-r', pct(r));
    if (s.done) set('need-note', '依你在退休測驗的答案;改答案後回來會自動更新。');
    document.querySelectorAll<HTMLElement>('[data-hit]').forEach((td) => {
      const v = rate[td.dataset.of as 'be' | 'r'];
      const h = v == null ? null : historyHitRate(hit[td.dataset.hit as string] ?? [], v);
      td.textContent = h == null ? '–' : `${Math.round(h * 100)}%`;
    });
  </script>
</Base>
