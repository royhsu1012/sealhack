---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { LEARN_PATH, href } from '../nav';

interface Props { title: string; description?: string; headings?: { depth: number; slug: string; text: string }[]; }
const { title, description, headings = [] } = Astro.props;
const path = Astro.url.pathname;
// 上/下頁走學習主線(非側欄順序);參考/支線頁不在主線上,不顯示線性導覽。
const pidx = LEARN_PATH.findIndex((i) => href(i.slug) === path);
const onPath = pidx >= 0;
const prev = onPath && pidx > 0 ? LEARN_PATH[pidx - 1] : null;
const next = onPath && pidx < LEARN_PATH.length - 1 ? LEARN_PATH[pidx + 1] : null;
const done = onPath && pidx === LEARN_PATH.length - 1; // 主線最後一頁 → 完賽指路
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 grid grid-cols-1 lg:grid-cols-[240px_minmax(0,1fr)_200px] gap-8 py-8">
    <!-- 側欄 -->
    <div class="hidden lg:block" data-pagefind-ignore>
      <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2">
        <Sidebar />
      </div>
    </div>
    <!-- 內文 -->
    <article class="min-w-0">
      <h1 class="text-3xl font-extrabold mb-2">{title}</h1>
      {description && <p class="text-lg mb-6" style="color:var(--fg-muted)">{description}</p>}
      {toc.length > 0 && (
        <details class="lg:hidden mb-6 rounded-lg border" style="border-color:var(--border);background:var(--bg-card)">
          <summary class="px-4 py-2.5 text-sm font-semibold cursor-pointer select-none">本頁內容</summary>
          <ul class="px-4 pb-3 space-y-1.5 text-sm" style="color:var(--fg-muted)">
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} class="block py-0.5">{h.text}</a></li>
            ))}
          </ul>
        </details>
      )}
      <div class="prose">
        <slot />
      </div>
      <!-- 上/下頁(學習主線;參考/支線頁不顯示)-->
      {(prev || next || done) && (
        <div class="mt-14 pt-6 border-t grid grid-cols-2 gap-4" style="border-color:var(--border)" data-pagefind-ignore>
          <div>{prev && (
            <a href={href(prev.slug)} class="block p-3 rounded-lg border hover:opacity-80" style="border-color:var(--border)">
              <div class="text-xs" style="color:var(--fg-muted)">上一頁</div>
              <div class="font-semibold mt-0.5">{prev.label}</div>
            </a>)}</div>
          <div>
            {next && (
            <a href={href(next.slug)} class="block p-3 rounded-lg border hover:opacity-80 text-right" style="border-color:var(--border)">
              <div class="text-xs" style="color:var(--fg-muted)">下一頁</div>
              <div class="font-semibold mt-0.5">{next.label}</div>
            </a>)}
            {done && (
            <a href="/cases/titanic/" class="block p-3 rounded-lg border hover:opacity-80 text-right" style="border-color:var(--brand);background:color-mix(in srgb, var(--brand) 8%, transparent)">
              <div class="text-xs" style="color:var(--brand)">🎉 主線走完了</div>
              <div class="font-semibold mt-0.5">看實戰成績:七場比賽 →</div>
            </a>)}
          </div>
        </div>
      )}
    </article>
    <!-- TOC -->
    <div class="hidden lg:block" data-pagefind-ignore>
      {toc.length > 0 && (
        <div class="sticky top-20 text-sm">
          <div class="text-xs font-semibold uppercase tracking-wide mb-2" style="color:var(--fg-muted)">本頁內容</div>
          <ul class="space-y-1.5" data-toc>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} class="block hover:opacity-100" style="color:var(--fg-muted)">{h.text}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</Base>
<script is:inline>
  // 桌面 TOC scroll-spy(DESIGN §六):目前章節染 brand 色
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('[data-toc] a'));
    if (!links.length || !('IntersectionObserver' in window)) return;
    var byId = {};
    links.forEach(function (a) { byId[decodeURIComponent(a.hash.slice(1))] = a; });
    var hs = Object.keys(byId).map(function (id) { return document.getElementById(id); }).filter(Boolean);
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) {
          links.forEach(function (l) { l.style.color = 'var(--fg-muted)'; l.style.fontWeight = ''; });
          var l = byId[e.target.id];
          if (l) { l.style.color = 'var(--brand)'; l.style.fontWeight = '600'; }
        }
      });
    }, { rootMargin: '-5% 0px -70% 0px' });
    hs.forEach(function (h) { io.observe(h); });
  })();
</script>
