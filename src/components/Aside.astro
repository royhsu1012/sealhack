---
// 取代 Starlight 的 <Aside>。用法:<Aside type="caution" title="...">內容</Aside>
interface Props { type?: 'note' | 'tip' | 'caution'; title?: string; }
const { type = 'note', title } = Astro.props;
const styles = {
  note:    { c: 'var(--aside-note)', icon: 'ℹ', label: '注意' },
  tip:     { c: 'var(--aside-tip)', icon: '✓', label: '訣竅' },
  caution: { c: 'var(--aside-caution)', icon: '⚠', label: '當心' },
}[type];
---
<aside class="my-5 rounded-lg border-l-4 p-4" style={`border-color:${styles.c};background:var(--bg-soft)`}>
  <div class="mb-1">
    <span class="tag" style={`color:${styles.c};background:color-mix(in srgb, ${styles.c} 16%, transparent)`}>{styles.icon} {title ?? styles.label}</span>
  </div>
  <div class="prose"><slot /></div>
</aside>
