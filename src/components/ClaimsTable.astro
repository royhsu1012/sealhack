---
import data from '../data/claims.json';
const badge = (v) => (v === true || v === 'done') ? '✅' : v === 'pending' ? '⏳' : '—';
// 依 id 前綴分兩區:C 主張(保留檔內人工順序 C1a–C12)在前、示範案例在後。
// 分組靠前綴而非陣列位置,新列不論 append 在哪都自動歸位。
const claimRows = data.claims.filter((c) => c.id.startsWith('C'));
const demoRows = data.claims.filter((c) => !c.id.startsWith('C'));
const rows = [...claimRows, ...demoRows];
const firstDemo = demoRows.length ? claimRows.length : -1; // 示範區起點(無示範列則不畫分隔)
---
<div class="sh-table">
  <table>
    <thead>
      <tr><th>#</th><th>主張</th><th>L1</th><th>L2</th><th>L3</th><th>證據 · 驗證腳本</th></tr>
    </thead>
    <tbody>
      {rows.map((c, i) => (
        <>
          {i === firstDemo && (
            <tr class="sh-group"><td colspan="6">↓ 以下是<strong>示範案例</strong>(不是主張,是把方法論完整走一遍的實例)</td></tr>
          )}
        <tr>
          <td><code>{c.id}</code></td>
          <td>
            {c.statement}
            {c.revision && <div class="sh-rev">修訂:{c.revision}</div>}
          </td>
          <td class="sh-c">{badge(c.L1)}</td>
          <td class="sh-c">{badge(c.L2)}</td>
          <td class="sh-c">{badge(c.L3)}</td>
          <td>
            <div>{c.evidence}</div>
            <div class="sh-scripts">
              {c.scripts.map((s) => (
                <a href={`/validation/${s}`}>{s}</a>
              ))}
            </div>
          </td>
        </tr>
        </>
      ))}
    </tbody>
  </table>
</div>
<style>
  .sh-table { overflow-x: auto; }
  .sh-table table { width: 100%; font-size: 0.9rem; }
  .sh-c { text-align: center; white-space: nowrap; }
  .sh-rev { font-size: 0.8rem; color: var(--fg-muted); margin-top: 0.25rem; }
  .sh-scripts { margin-top: 0.35rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .sh-scripts a { font-size: 0.8rem; font-family: var(--font-mono); }
  .sh-group td { padding-top: 0.7rem; font-size: 0.85rem; font-weight: 600; color: var(--fg-muted); border-top: 2px solid var(--border); }
  .sh-group strong { color: var(--fg); }
</style>
