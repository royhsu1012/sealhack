---
// 答案區:想幾歲退休 → 需要準備多少錢、年化報酬率至少多少,右側是報酬率量表
interface Props { split?: boolean }
const { split = false } = Astro.props;
---
<section class="mx-auto max-w-6xl px-4 pt-6 sm:pt-8 grid gap-6 sm:gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] items-end">
  <div id="answer" aria-live="polite">
    <h1 id="hero-kicker" class="text-lg sm:text-xl font-bold"></h1>
    <div class="mt-3 grid grid-cols-2 gap-4 sm:gap-8 max-w-xl">
      <div>
        <p class="text-sm font-semibold muted">需要準備</p>
        <p id="hero-target" class="hero-num num mt-1"></p>
      </div>
      <div>
        <p class="text-sm font-semibold muted">年化報酬率至少</p>
        <p id="hero-rate" class="hero-num num mt-1"></p>
      </div>
    </div>
    <p id="hero-sub" class="mt-4 text-base sm:text-lg max-w-xl muted"></p>
  </div>
  <div class="card p-4 sm:p-5">
    <p id="gauge-title" class="font-bold">需要的報酬率落在哪裡</p>
    <div id="gauge" class="chart mt-2"></div>
    {split && <dl id="r-split" class="r-split" aria-label="三種累積方式各需要的報酬率"></dl>}
  </div>
</section>
