---
// 數學公式:一行一個式子,下標 / 上標用 HTML。
// 寫法:X_t、X_{n+k} → 下標;^t、^{n − t} → 上標;以兩個空白開頭的行是上一行的延續(縮排)。
// 螢幕太窄或字級放大時,只在運算子(= + − × ÷ ~)前面換行,括號裡的東西不拆開,換行後懸掛縮排。
// where = [符號, 說明] 列在式子下方。
interface Props { lines: string[]; where?: [string, string][] }
const { lines, where = [] } = Astro.props;

const math = (s: string) => s
  .replace(/_\{([^}]*)\}/g, '<sub>$1</sub>')
  .replace(/_([\p{L}\d]+)/gu, '<sub>$1</sub>')
  .replace(/\^\{([^}]*)\}/g, '<sup>$1</sup>')
  .replace(/\^([\p{L}\d]+)/gu, '<sup>$1</sup>');

/** 用括號外的空白切成小段,運算子跟後面那段黏在一起;每段不換行 */
const OPS = new Set(['=', '+', '−', '-', '×', '÷', '~']);
function chunks(line: string) {
  const parts: string[] = [];
  let depth = 0, cur = '';
  for (const ch of line) {
    if ('([{'.includes(ch)) depth++;
    if (')]}'.includes(ch)) depth--;
    if (ch === ' ' && depth === 0) { if (cur) parts.push(cur); cur = ''; } else cur += ch;
  }
  if (cur) parts.push(cur);
  const out: string[] = [];
  for (let i = 0; i < parts.length; i++) {
    if (OPS.has(parts[i]) && i + 1 < parts.length) { out.push(`${parts[i]} ${parts[i + 1]}`); i++; } else out.push(parts[i]);
  }
  return out.map((c) => `<span class="eq-t">${math(c)}</span>`).join(' ');
}
---
<div class="eq">
  <div class="eq-lines">
    {lines.map((l) => <div class:list={['eq-line', { 'eq-cont': l.startsWith('  ') }]} set:html={chunks(l.trim())} />)}
  </div>
  {where.length > 0 && (
    <dl class="eq-where">
      {where.map(([k, v]) => <div><dt set:html={math(k)} /><dd set:html={math(v)} /></div>)}
    </dl>
  )}
</div>
