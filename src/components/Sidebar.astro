---
import { NAV, href } from '../nav';
const path = Astro.url.pathname;
---
<nav class="text-sm">
  {NAV.map((g) => (
    <div class="mb-5">
      {g.group && <div class="text-xs font-semibold uppercase tracking-wide mb-2" style="color:var(--fg-muted)">{g.group}</div>}
      <ul class="space-y-0.5">
        {g.items.map((it) => {
          const active = path === href(it.slug);
          return (
            <li>
              <a href={href(it.slug)} class={active ? 'block px-3 py-1.5 rounded-md transition sh-sidebar-link is-active' : 'block px-3 py-1.5 rounded-md transition sh-sidebar-link'}
                 style={active ? 'background:color-mix(in srgb, var(--brand) 15%, transparent);color:var(--brand);font-weight:600'
                               : 'color:var(--fg-muted)'}>{it.label}</a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sh-sidebar-link:not(.is-active):hover { background: var(--bg-soft); }
</style>
