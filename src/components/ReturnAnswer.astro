---
// 答案區(兩版共用):需要準備 vs 退休時存得到、夠不夠、最早幾年幾個月後能退休;右側是報酬率滑桿。
// 內容由 shared.js 的 renderAnswer 填入。
const R_MAX = 12;
const ticks = [0, 2, 4, 6, 8, 10, 12];
const zones = [
  ['var(--free)', '4% 以下:保守配置即可'],
  ['var(--gold)', '4–7%:需要股票部位'],
  ['var(--warn)', '7% 以上:偏積極'],
];
---
<section class="mx-auto max-w-6xl px-4 pt-6 sm:pt-8 grid gap-6 sm:gap-8 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] items-end">
  <div id="answer" aria-live="polite">
    <h1 id="hero-kicker" class="text-lg sm:text-xl font-bold"></h1>
    <div class="mt-3 grid grid-cols-2 gap-4 sm:gap-8 max-w-xl">
      <div>
        <p class="text-sm font-semibold muted">需要準備</p>
        <p id="hero-need" class="hero-num num mt-1"></p>
      </div>
      <div>
        <p id="hero-have-label" class="text-sm font-semibold muted">退休時存得到</p>
        <p id="hero-have" class="hero-num num mt-1"></p>
      </div>
    </div>
    <p id="hero-status" class="mt-4"></p>
    <p id="hero-when" class="when mt-4 max-w-xl"></p>
    <p id="hero-sub" class="mt-3 text-sm sm:text-base max-w-xl muted"></p>
  </div>

  <form id="ret-form" class="card p-4 sm:p-5" autocomplete="off" onsubmit="return false">
    <div class="knob-head">
      <label class="font-bold" for="assumedReturn-num">如果每年投資報酬</label>
      <div class="knob-value">
        <input id="assumedReturn-num" type="number" inputmode="decimal" step="0.1" data-knob="assumedReturn" data-pct="1" />
        <span>%</span>
      </div>
    </div>
    <div class="ret" style={`--z1:${(4 / R_MAX) * 100}%;--z2:${(7 / R_MAX) * 100}%`}>
      <div class="ret-mark" id="ret-mark" hidden><span id="ret-mark-label" class="ret-mark-label"></span></div>
      <input class="ret-range" type="range" min="0" max={R_MAX} step="0.1" data-knob="assumedReturn" data-pct="1" aria-label="每年投資報酬率" />
      <div class="ret-scale" aria-hidden="true">
        {ticks.map((v) => <span style={`--f:${v / R_MAX}`}>{v}%</span>)}
      </div>
    </div>
    <p class="legend">
      {zones.map(([c, s]) => <span><span style={`color:${c}`}>■</span> {s}</span>)}
    </p>
    <p class="text-xs muted mt-2">退休前後都用這個報酬率:報酬越高,要準備的錢越少、存得到的錢越多。</p>
  </form>
</section>
