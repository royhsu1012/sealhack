---
import data from '../data/cases.json';
const t = data.titanic;
const bestLb = Math.max(...t.submissions.map((s) => s.public_lb));
---
<div class="sh-table">
  <table>
    <caption>鐵達尼真提交(n_train={t.n_train} / holdout={t.n_holdout})</caption>
    <thead><tr><th>提交</th><th>CV(交叉驗證)</th><th>holdout</th><th>public LB(排行榜)</th></tr></thead>
    <tbody>
      {t.submissions.map((s) => (
        <tr><td>{s.name}</td><td>{s.cv}</td><td>{s.holdout}</td><td><strong>{s.public_lb}</strong>{s.public_lb === bestLb && <span class="tag tag-pass">最佳</span>}</td></tr>
      ))}
    </tbody>
  </table>
  <table>
    <caption>多案例真實資料(同一套 harness)</caption>
    <thead><tr><th>案例</th><th>任務</th><th>CV(交叉驗證)</th><th>holdout</th><th>CV−holdout 差</th></tr></thead>
    <tbody>
      {data.multi_case_real.map((c) => (
        <tr><td>{c.name}</td><td>{c.task}</td><td>{c.cv}</td><td>{c.holdout}</td><td>{c.gap}</td></tr>
      ))}
    </tbody>
  </table>
</div>
