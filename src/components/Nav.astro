---
import P from '../data/seal-pixels.json';
import { iconRects, ICON_SIZE } from '../scripts/seal-cells.js';
const path = Astro.url.pathname;
// 「首頁」與左上角海豹都回開場(/?home);做過測驗的人在開場可以重新測驗或看上次的結果
const links = [
  { label: '首頁', href: '/?home', home: true },
  { label: '投資方法', href: '/invest/' },
  { label: '怎麼算的', href: '/method/' },
];
const isActive = (h: string) => (h === '/?home' ? path === '/' : path.startsWith(h));
---
<header class="border-b" style="border-color:var(--line)">
  <div class="mx-auto max-w-6xl px-3 sm:px-4 h-14 flex items-center gap-2 sm:gap-5">
    <a href="/?home" class="flex items-center gap-2 h-10 min-w-10 font-extrabold shrink-0" aria-label="SealHack FIRE 首頁" data-home>
      <svg width="32" height="30" viewBox={`0 0 ${ICON_SIZE.w} ${ICON_SIZE.h}`} shape-rendering="crispEdges" aria-hidden="true">
        {iconRects(P).map(([x, y, w, c]) => <rect x={x} y={y} width={w} height="1" fill={`var(--sp-${c})`} />)}
      </svg>
      <span class="hidden sm:inline">SealHack FIRE</span>
    </a>
    <nav class="flex items-center gap-1 sm:gap-2 text-[13px] sm:text-sm whitespace-nowrap">
      {links.map((l) => (
        <a href={l.href} class="min-w-10 text-center px-1.5 sm:px-2 py-2.5" style={isActive(l.href) ? 'color:var(--ink);font-weight:700' : 'color:var(--ink-2)'} aria-current={isActive(l.href) ? 'page' : undefined} data-home={l.home ? '' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="flex-1"></div>
    <a href="https://github.com/royhsu1012/sealhack" class="hidden sm:inline px-2 py-2.5 text-sm muted">GitHub</a>
    <button id="theme-toggle" aria-label="切換深淺色" class="shrink-0 w-10 h-10 grid place-items-center rounded-lg border" style="border-color:var(--line)">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</header>
<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const el = document.documentElement;
    el.classList.toggle('dark');
    try { localStorage.setItem('fire-theme', el.classList.contains('dark') ? 'dark' : 'light'); } catch (e) {}
  });
</script>
