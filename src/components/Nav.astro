---
const path = Astro.url.pathname;
const links = [
  { label: '試算器', href: '/' },
  { label: '計算方法', href: '/method/' },
];
const isActive = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<header class="sticky top-0 z-40 border-b backdrop-blur" style="border-color:var(--border);background:color-mix(in srgb, var(--bg) 82%, transparent)">
  <div class="mx-auto max-w-6xl px-4 h-14 flex items-center gap-3 sm:gap-6">
    <a href="/" class="flex items-center gap-2 font-extrabold text-lg shrink-0">
      <span class="inline-grid place-items-center w-7 h-7 rounded-md text-white" style="background:var(--brand)">S</span>
      <span class="hidden sm:inline">SealHack <span class="font-semibold text-sm" style="color:var(--fg-muted)">FIRE</span></span>
    </a>
    <nav class="flex items-center gap-4 sm:gap-5 text-sm whitespace-nowrap" style="color:var(--fg-muted)">
      {links.map((l) => (
        <a href={l.href} class="hover:opacity-100 transition pb-1" style={`opacity:${isActive(l.href) ? 1 : 0.75};border-bottom:2px solid ${isActive(l.href) ? 'var(--brand)' : 'transparent'};${isActive(l.href) ? 'color:var(--fg)' : ''}`}>{l.label}</a>
      ))}
    </nav>
    <div class="flex-1"></div>
    <a href="https://github.com/royhsu1012/sealhack" class="hidden sm:inline text-sm hover:opacity-80" style="color:var(--fg-muted)">GitHub</a>
    <button id="theme-toggle" aria-label="切換主題" class="w-10 h-10 grid place-items-center rounded-md border hover:opacity-80" style="border-color:var(--border)">
      <span class="text-sm">◐</span>
    </button>
  </div>
</header>
<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const el = document.documentElement;
    el.classList.toggle('light');
    try { localStorage.setItem('sh-theme', el.classList.contains('light') ? 'light' : 'dark'); } catch (e) {}
    document.dispatchEvent(new CustomEvent('themechange'));
  });
</script>
