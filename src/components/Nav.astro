---
import { NAV, href } from '../nav';
const path = Astro.url.pathname;
const links = [
  { label: '快速版', href: '/workflow/quickstart/' },
  { label: '方法論', href: '/workflow/0-diagnose/' },
  { label: '證據', href: '/claims/' },
  { label: '案例', href: '/cases/titanic/' },
];
---
<header class="sticky top-0 z-40 border-b backdrop-blur" style="border-color:var(--border);background:color-mix(in srgb, var(--bg) 82%, transparent)">
  <div class="mx-auto max-w-6xl px-4 h-14 flex items-center gap-6">
    <a href="/" class="flex items-center gap-2 font-extrabold text-lg shrink-0">
      <span class="inline-grid place-items-center w-7 h-7 rounded-md text-white" style="background:var(--brand)">S</span>
      SealHack
    </a>
    <nav class="hidden md:flex items-center gap-5 text-sm" style="color:var(--fg-muted)">
      {links.map((l) => (
        <a href={l.href} class="hover:opacity-100 transition" style={`opacity:${path.startsWith(l.href) ? 1 : 0.75};${path.startsWith(l.href) ? 'color:var(--fg)' : ''}`}>{l.label}</a>
      ))}
    </nav>
    <div class="flex-1"></div>
    <a href="https://github.com/royhsu1012/sealhack" class="hidden sm:inline text-sm hover:opacity-80" style="color:var(--fg-muted)">GitHub</a>
    <button id="search-open" aria-label="搜尋" title="搜尋 (Ctrl/⌘K)" class="w-8 h-8 grid place-items-center rounded-md border hover:opacity-80" style="border-color:var(--border)">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    </button>
    <button id="theme-toggle" aria-label="切換主題" class="w-8 h-8 grid place-items-center rounded-md border hover:opacity-80" style="border-color:var(--border)">
      <span class="text-sm">◐</span>
    </button>
    <a href="/workflow/quickstart/" class="hidden sm:inline text-sm font-semibold px-3 py-1.5 rounded-md text-white shrink-0" style="background:var(--brand)">開始</a>
    <button id="menu-toggle" aria-label="選單" class="md:hidden w-8 h-8 grid place-items-center rounded-md border" style="border-color:var(--border)">
      <span class="text-lg leading-none">☰</span>
    </button>
  </div>

  <!-- 行動選單 -->
  <div id="mobile-menu" class="hidden md:hidden border-t max-h-[80vh] overflow-y-auto" style="border-color:var(--border);background:var(--bg)">
    <div class="px-4 py-4 space-y-5 text-sm">
      {NAV.map((g) => (
        <div>
          {g.group && <div class="text-xs font-semibold uppercase tracking-wide mb-1.5" style="color:var(--fg-muted)">{g.group}</div>}
          <ul class="space-y-0.5">
            {g.items.map((it) => (
              <li><a href={href(it.slug)} class="block px-2 py-1.5 rounded"
                     style={path === href(it.slug) ? 'color:var(--brand);font-weight:600' : 'color:var(--fg)'}>{it.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- 搜尋 modal(索引由 pagefind 於 build 產出,dev 模式無索引)-->
  <div id="search-modal" class="hidden fixed inset-0 z-50" role="dialog" aria-modal="true" aria-label="站內搜尋">
    <div id="search-backdrop" class="absolute inset-0" style="background:rgba(0,0,0,.6)"></div>
    <div class="relative mx-auto mt-[10vh] w-[92%] max-w-2xl rounded-xl border shadow-2xl overflow-hidden" style="border-color:var(--border);background:var(--bg-card)">
      <div id="search" class="p-3"></div>
    </div>
  </div>
</header>
<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const el = document.documentElement;
    el.classList.toggle('light');
    localStorage.setItem('sh-theme', el.classList.contains('light') ? 'light' : 'dark');
  });
  document.getElementById('menu-toggle')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });

  // 站內搜尋(Pagefind,首次開啟才載入索引 UI)
  (function () {
    const modal = document.getElementById('search-modal');
    const openBtn = document.getElementById('search-open');
    const backdrop = document.getElementById('search-backdrop');
    if (!modal || !openBtn) return;
    let loaded = false;
    function loadPF() {
      if (loaded) return;
      loaded = true;
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);
      const js = document.createElement('script');
      js.src = '/pagefind/pagefind-ui.js';
      js.onload = function () {
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: { placeholder: '搜尋方法論、主張、詞彙…', zero_results: '找不到「[SEARCH]」', clear_search: '清除' },
        });
        const i = modal.querySelector('input');
        if (i) i.focus();
      };
      js.onerror = function () {
        document.getElementById('search').innerHTML =
          '<div style="padding:1rem;color:var(--fg-muted);font-size:.9rem">搜尋索引只在正式建置後可用(<code>npm run build</code> 後預覽)。</div>';
      };
      document.body.appendChild(js);
    }
    function open() {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      loadPF();
      const i = modal.querySelector('input');
      if (i) i.focus();
    }
    function close() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
    openBtn.addEventListener('click', open);
    backdrop?.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        modal.classList.contains('hidden') ? open() : close();
      } else if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        close();
      }
    });
  })();
</script>
